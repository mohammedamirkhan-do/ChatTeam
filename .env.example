# Server
PORT=3000
DATABASE_URL=mongodb://localhost:27017/teamchat
REDIS_URL=redis://localhost:6379
JWT_SECRET=dev-only-change-me
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN_DAYS=30
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# S3-compatible storage (SeaweedFS local, MinIO or AWS — config-only swap)
S3_ENDPOINT=http://localhost:8333
S3_BUCKET=teamchat
S3_REGION=us-east-1
S3_ACCESS_KEY=teamchat
S3_SECRET_KEY=teamchat-dev-only
S3_FORCE_PATH_STYLE=true
FILE_MAX_MB=50

# Desktop renderer
VITE_API_URL=http://localhost:3000
VITE_WS_URL=http://localhost:3000